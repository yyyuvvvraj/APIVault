{
  "openapi": "3.1.0",
  "info": {
    "title": "APIVault Public API",
    "version": "0.1.0",
    "description": "Read-only API for ACTIVE and VERIFIED catalogue entries. Anonymous access remains available; optional APIVault API keys identify integrations and receive per-key rate limiting."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "APIVault API on the current host"
    }
  ],
  "paths": {
    "/apis": {
      "get": {
        "operationId": "listApis",
        "summary": "List verified APIs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "pricing",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "FREE",
                "FREEMIUM",
                "PAID",
                "OPEN_SOURCE",
                "UNKNOWN"
              ]
            }
          },
          {
            "name": "auth",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "API_KEY",
                "OAUTH2",
                "BEARER_TOKEN",
                "BASIC_AUTH",
                "NONE",
                "CUSTOM",
                "UNKNOWN"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "recent",
                "verified",
                "newest",
                "name"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Optional entity-tag validator. A matching validator returns 304 Not Modified.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API cards with page, limit, total and totalPages pagination.",
            "headers": {
              "ETag": {
                "description": "Entity tag for the returned representation.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The representation has not changed; reuse the previously cached response body.",
            "headers": {
              "ETag": {
                "description": "Current entity tag.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/apis/{slug}": {
      "get": {
        "operationId": "getApiBySlug",
        "summary": "Get a verified API",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Optional entity-tag validator. A matching validator returns 304 Not Modified.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API detail object.",
            "headers": {
              "ETag": {
                "description": "Entity tag for the returned representation.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The representation has not changed; reuse the previously cached response body.",
            "headers": {
              "ETag": {
                "description": "Current entity tag.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "List categories",
        "responses": {
          "200": {
            "description": "Array of category name and slug objects.",
            "headers": {
              "ETag": {
                "description": "Entity tag for the returned representation.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The representation has not changed; reuse the previously cached response body.",
            "headers": {
              "ETag": {
                "description": "Current entity tag.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Optional entity-tag validator. A matching validator returns 304 Not Modified.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/account/keys": {
      "get": {
        "summary": "List the authenticated user's API keys",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Key metadata only; raw secrets are never returned."
          },
          "401": {
            "description": "Authentication required."
          }
        }
      },
      "post": {
        "summary": "Create a read-only API key",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                  },
                  "expiresInDays": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "enum": [
                      30,
                      90,
                      365,
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created key metadata and the raw secret, returned once."
          },
          "401": {
            "description": "Authentication required."
          },
          "409": {
            "description": "Active key limit reached."
          }
        }
      }
    },
    "/account/keys/{id}": {
      "delete": {
        "summary": "Revoke one of the authenticated user's API keys",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key revoked."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Key not found."
          }
        }
      }
    },
    "/account/profile": {
      "get": {
        "summary": "Get the current user's contributor profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Private profile settings."
          },
          "401": {
            "description": "Authentication required."
          }
        }
      },
      "put": {
        "summary": "Create or update the current user's contributor profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile saved."
          },
          "400": {
            "description": "Invalid profile."
          },
          "401": {
            "description": "Authentication required."
          },
          "409": {
            "description": "Handle is already in use."
          }
        }
      }
    },
    "/submissions": {
      "post": {
        "summary": "Submit an API suggestion or update for moderation",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Submission accepted into the moderation queue."
          },
          "400": {
            "description": "Invalid submission."
          },
          "401": {
            "description": "Authentication required."
          },
          "429": {
            "description": "Submission rate limit exceeded."
          }
        }
      }
    },
    "/contributors/{handle}": {
      "get": {
        "summary": "Get an opted-in public contributor profile",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public profile and approved contribution count."
          },
          "404": {
            "description": "Profile is private or does not exist."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "ApiCard": {
        "type": "object",
        "description": "Public card: id, slug, name, summary, provider, homepageUrl, documentationUrl, pricingModel, categories, tags, authMethods, verifiedAt, lastCheckedAt."
      },
      "ApiDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiCard"
          },
          {
            "type": "object",
            "description": "Adds description, baseUrl, pricingSummary, verification, sources, rateLimits and pricingPlans."
          }
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "Error response body contains error and message.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The client exceeded the public API rate limit. Retry after the duration in the Retry-After header.",
        "headers": {
          "Retry-After": {
            "description": "Seconds until the current rate-limit window resets.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "Maximum requests permitted in the current window.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Requests remaining in the current window.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Reset": {
            "description": "Unix timestamp when the current window resets.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiVaultBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "APIVault API key",
        "description": "Optional read-only key created from the authenticated APIVault account. Use Authorization: Bearer av_live_…"
      },
      "ApiVaultHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Optional read-only APIVault API key."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Better Auth session cookie; account routes require an authenticated session."
      }
    }
  },
  "security": [
    {},
    {
      "ApiVaultBearer": []
    },
    {
      "ApiVaultHeader": []
    }
  ]
}
