{
  "openapi": "3.1.0",
  "info": {
    "title": "APIVault Public API",
    "version": "1.0.0",
    "description": "Read-only API for ACTIVE and VERIFIED catalogue entries."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "APIVault API on the current host"
    }
  ],
  "paths": {
    "/apis": {
      "get": {
        "operationId": "listApis",
        "summary": "List verified APIs",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "pricing",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "FREE",
                "FREEMIUM",
                "PAID",
                "OPEN_SOURCE",
                "UNKNOWN"
              ]
            }
          },
          {
            "name": "auth",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "API_KEY",
                "OAUTH2",
                "BEARER_TOKEN",
                "BASIC_AUTH",
                "NONE",
                "CUSTOM",
                "UNKNOWN"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "recent",
                "verified",
                "newest",
                "name"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Optional entity-tag validator. A matching validator returns 304 Not Modified.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API cards with page, limit, total and totalPages pagination.",
            "headers": {
              "ETag": {
                "description": "Entity tag for the returned representation.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The representation has not changed; reuse the previously cached response body.",
            "headers": {
              "ETag": {
                "description": "Current entity tag.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/apis/{slug}": {
      "get": {
        "operationId": "getApiBySlug",
        "summary": "Get a verified API",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Optional entity-tag validator. A matching validator returns 304 Not Modified.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API detail object.",
            "headers": {
              "ETag": {
                "description": "Entity tag for the returned representation.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The representation has not changed; reuse the previously cached response body.",
            "headers": {
              "ETag": {
                "description": "Current entity tag.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "List categories",
        "responses": {
          "200": {
            "description": "Array of category name and slug objects.",
            "headers": {
              "ETag": {
                "description": "Entity tag for the returned representation.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The representation has not changed; reuse the previously cached response body.",
            "headers": {
              "ETag": {
                "description": "Current entity tag.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Response caching directives.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Optional entity-tag validator. A matching validator returns 304 Not Modified.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "ApiCard": {
        "type": "object",
        "description": "Public card: id, slug, name, summary, provider, homepageUrl, documentationUrl, pricingModel, categories, tags, authMethods, verifiedAt, lastCheckedAt."
      },
      "ApiDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiCard"
          },
          {
            "type": "object",
            "description": "Adds description, baseUrl, pricingSummary, verification, sources, rateLimits and pricingPlans."
          }
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "Error response body contains error and message.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The client exceeded the public API rate limit. Retry after the duration in the Retry-After header.",
        "headers": {
          "Retry-After": {
            "description": "Seconds until the current rate-limit window resets.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "Maximum requests permitted in the current window.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Requests remaining in the current window.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Reset": {
            "description": "Unix timestamp when the current window resets.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
