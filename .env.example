# Set POSTGRES_PASSWORD to a strong local-only password before starting Docker.
# Do not commit your .env file.
POSTGRES_USER=apivault
POSTGRES_PASSWORD=
POSTGRES_DB=apivault

# After setting POSTGRES_PASSWORD above, add the same password to this URL.
DATABASE_URL="postgresql://apivault@localhost:5432/apivault?schema=public"

# Better Auth: generate with "npx auth@latest secret".
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# Optional Go verifier worker. Use a random secret of at least 32 characters.
# Start it with: docker compose --profile workers up --build verifier
VERIFIER_SHARED_SECRET=
APIVAULT_INTERNAL_URL="http://host.docker.internal:3000"
VERIFIER_SCAN_INTERVAL=30m
VERIFIER_CONCURRENCY=8
